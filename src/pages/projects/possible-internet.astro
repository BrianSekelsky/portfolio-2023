---
import Layout from "../../layouts/Layout.astro";

import ProjectHeader from "../../components/ProjectHeader.astro";
import SmallHeading from "../../components/SmallHeading.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import Link from "../../components/Link.astro";
import { Image } from "astro:assets";

import mp4 from "../../images/possible-internet/possible-internet.mp4";
import sketch1 from "../../images/possible-internet/sketches.jpg";
import sketch2 from "../../images/possible-internet/sketches-2.jpg";
import research from "../../images/possible-internet/research.jpg";

import antlers from "../../images/possible-internet/Antlers.png";
import reference from "../../images/possible-internet/Expanded Reference.png";
import reference2 from "../../images/possible-internet/Expanded Reference 2.png";
import secondaryantlers from "../../images/possible-internet/Secondary Antlers.png";
import secondarysection from "../../images/possible-internet/Secondary Section.png";
import secondarysection2 from "../../images/possible-internet/Secondary Section 2.png";
import webofreferences from "../../images/possible-internet/Web of References.png";
---

<Layout title="Brian Sekelsky">
  <main>
    <ProjectHeader
      title="Possible Internet"
      objective="A speculative reading environment where extended reality lets you organize texts around the whole room. You move from the couch, to standing, to your desk, and everything stays connected by wires as you go."
      types={["Speculative", "Augmented Reality", "Research", "Case Study"]}
      collaborators={["Jeff Wilkinson"]}
      year="2022"
      myColor="#FCEDDD"
    />
    <div class="site-padding-flush load-in">
      <div class="header-card">
        <div class="project-hero">
          <video class="w-full block" playsinline controls muted loop>
            <source src={mp4} type="video/mp4" />
          </video>
        </div>
      </div>
    </div>
    <div class="">
      <ProjectGrid>
        <div class="col-span-1">
          <Image class="" src={antlers} alt="Antlers" />
        </div>
        <div class="col-span-1">
          <Image
            class=""
            src={webofreferences}
            alt="web of references"
          />
        </div>
        <div class="col-span-2">
          <Image class="" src={reference} alt="expanded reference" />
        </div>
        <div class="col-span-1">
          <Image class="" src={reference2} alt="expanded reference" />
        </div>
        <div class="col-span-1">
          <Image
            class=""
            src={secondaryantlers}
            alt="secondary antlers"
          />
        </div>
        <div class="col-span-1">
          <Image
            class=""
            src={secondarysection}
            alt="secondary section"
          />
        </div>
        <div class="col-span-1">
          <Image
            class=""
            src={secondarysection2}
            alt="secondary section"
          />
        </div>
        <div class="col-span-1">
          <SmallHeading text="Research" />
          <p>
            We started with a text ribbon, imagining how text might read in 3D
            space using
            <Link
              name="Rapid Serial Visual Presentation speed reading technology."
              href="https://en.wikipedia.org/wiki/Rapid_serial_visual_presentation"
            />
          </p>
        </div>
        <!--////////////////////////////-->
        <div class="col-span-1">
          <Image
            class=""
            src={sketch1}
            alt="Image of miro board with sketches"
          />
        </div>
        <div class="col-span-1">
          <p>
            Basic sketches and some gifs in Processing, imagining how a research
            paper might sit inside this framework.
          </p>
        </div>
        <!--////////////////////////////-->
        <div class="col-span-1">
          <Image
            class=""
            src={sketch2}
            alt="Image of miro board with sketches"
          />
        </div>
        <div class="col-span-1">
          <p>
            I used p5.js to rough out the 3D spaces quickly before committing to
            a fuller video.
          </p>
        </div>
        <div class="col-span-1">
          <iframe
            width="100%"
            height="700px"
            class="overflow-hidden"
            src="https://editor.p5js.org/bsekels/full/20gwFcDb6"></iframe>
        </div>
        <div class="col-span-1">
          <SmallHeading text="Final prototype video" />
          <p>Made in Blender. It shows how extended reality could change an academic literature review session.</p>
        </div>
        <div class="col-span-1">
          <iframe
            src="https://player.vimeo.com/video/769969951?h=0d93dceb26"
            class="w-full aspect-video border-0"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen></iframe>
        </div>
        <div class="col-span-1">
          Collaborative research and critiques were done in a big miro board.
        </div>
        <div class="col-span-1">
          <Image
            class=""
            src={research}
            alt="Image of miro board with sketches"
          />
        </div>
        <div class="col-span-2">
          <p>
            We modeled our studio space in Blender for the final prototype. In
            the video at the top of the page, a reader (the purple hand) works
            through Ashley Anderson's Master's Thesis, "Working with Imagery:
            Mediating Image Rescripting for Anxiety with Multimodal Digital
            Storytelling." The first set of antlers holds every section of the
            paper, and the reader can shift which one sits at the bottom.
          </p>
        </div>
      </ProjectGrid>
    </div>
  </main>
</Layout>
