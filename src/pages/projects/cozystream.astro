---
import Layout from "../../layouts/Layout.astro";

import ProjectHeader from "../../components/ProjectHeader.astro";
import SmallHeading from "../../components/SmallHeading.astro";
import ProjectGrid6Cols from "../../components/ProjectGrid6Cols.astro";
import { Image } from "astro:assets";
import Caption from "../../components/Caption.astro";

import heroVideo from "../../images/cozystream/hero-walkthrough.webm";
import heroVideoMp4 from "../../images/cozystream/hero-walkthrough.mp4";
import heroPoster from "../../images/cozystream/hero-walkthrough-poster.jpg";

import editingIssue from "../../images/cozystream/editing-movie-issue.webm";
import editingIssueMp4 from "../../images/cozystream/editing-movie-issue.mp4";
import editingIssuePoster from "../../images/cozystream/editing-movie-issue-poster.jpg";

import editingPoster from "../../images/cozystream/editing-movie-poster.webm";
import editingPosterMp4 from "../../images/cozystream/editing-movie-poster.mp4";
import editingPosterPoster from "../../images/cozystream/editing-movie-poster-poster.jpg";

import browseMain from "../../images/cozystream/browse-main.png";
import dvdCaseMode from "../../images/cozystream/dvd-case-mode.png";
import settingsAppearance from "../../images/cozystream/settings-appearance.png";
import themeComparison from "../../images/cozystream/theme-comparison.png";
import detailBackdrop from "../../images/cozystream/detail-backdrop.png";
import detailHeader from "../../images/cozystream/detail-header.png";

import playerDemo from "../../images/cozystream/player-demo.webm";
import playerDemoMp4 from "../../images/cozystream/player-demo.mp4";
import playerDemoPoster from "../../images/cozystream/player-demo-poster.jpg";
---

<Layout title="Brian Sekelsky">
  <main>
    <ProjectHeader
      title="Cozystream"
      objective="A self-hosted media server I designed and built for my household, and my girlfriend's parents who live across the country."
      types={["Product Design", "Engineering"]}
      collaborators={[]}
      year="2026"
      heroVideo={heroVideo}
      heroVideoMp4={heroVideoMp4}
      heroPoster={heroPoster.src}
    />

    <ProjectGrid6Cols>
      <!-- Section: Why not just use Plex? -->
      <div class="col-span-2">
        <SmallHeading text="Why not just use Plex?" />
        <p>
          Plex mixed ads into my library, charged for remote streaming, and ran
          everything through its cloud. I wanted my movies, shared with a few
          people, kept local.
        </p>
      </div>
      <div class="col-span-4">
        <Image
          src={browseMain}
          alt="Cozystream browse page showing a poster grid of movies"
          class="shadow-sm"
          loading="lazy"
        />
        <Caption text="Just my library. Nothing else." />
      </div>

      <!-- Section: Three users, three contexts -->
      <div class="col-span-6">
        <SmallHeading text="Three users, three contexts" />
      </div>
      <div class="col-span-2">
        <p>
          <strong>Me.</strong> The admin. I add movies, organize collections, and
          fix metadata.
        </p>
      </div>
      <div class="col-span-2">
        <p>
          <strong>My partner.</strong> Open, scroll, pick a movie, resume where
          she left off.
        </p>
      </div>
      <div class="col-span-2">
        <p>
          <strong>Her parents.</strong> Not technical, watching on an LG TV with
          a remote. If it doesn't just work, they'll call us.
        </p>
      </div>

      <!-- Section: Design goals -->
      <div class="col-span-6 sm:col-span-4 sm:col-start-2">
        <div class=" border border-zinc-200 bg-zinc-50 p-6 sm:p-8">
          <SmallHeading text="Design goals" />
          <ol class="list-decimal list-inside space-y-3">
            <li>
              <strong>The library is the UI.</strong> Posters front and center, minimal
              chrome around them.
            </li>
            <li>
              <strong>Zero learning curve.</strong> If you've used Netflix, you already
              know how this works.
            </li>
            <li>
              <strong>Built for a TV remote.</strong> If it works with four arrow
              keys and an OK button, it works for everyone.
            </li>
            <li>
              <strong>Make it feel like yours.</strong> Themes, colors, fonts, and
              spacing are all adjustable. A personal media server should feel personal.
            </li>
          </ol>
        </div>
      </div>

      <!-- Section: The UI should feel like yours -->
      <div class="col-span-2">
        <SmallHeading text="The UI should feel like yours" />
        <p>
          Six themes, eight accent colors, four font controls, and layout
          settings for card size, spacing, and density. Every change applies
          instantly. The accent picker checks contrast and suggests alternatives
          when a color doesn't read.
        </p>
      </div>
      <div class="col-span-4 flex flex-col items-center">
        <Image
          src={settingsAppearance}
          alt="Cozystream appearance settings with theme grid, accent picker, and font options"
          class="shadow-sm"
          loading="lazy"
        />
        <Caption
          text="Appearance settings: theme grid, accent picker, font options"
        />
      </div>

      <div class="col-span-3">
        <Image
          src={themeComparison}
          alt="Cozystream browse page shown in different color themes"
          class="shadow-sm"
          loading="lazy"
        />
        <Caption text="Same view, different themes" />
      </div>
      <div class="col-span-3">
        <Image
          src={dvdCaseMode}
          alt="Cozystream DVD Case mode with 3D case spines and lifted poster on hover"
          class="shadow-sm"
          loading="lazy"
        />
        <Caption text="DVD Case mode" />
      </div>
      <div class="col-span-6">
        <p>
          DVD Case mode is a nod to browsing a shelf. It swaps the flat grid for
          3D cases with spines, and hovering lifts the poster off a label
          underneath. No more functional than the default, just more physical.
        </p>
      </div>

      <!-- Section: How it comes together -->
      <div class="col-span-6">
        <SmallHeading text="How it comes together" />
      </div>

      <!-- Browse -->
      <div class="col-span-2">
        <SmallHeading text="Browse" />
        <p>
          Poster rows. Some I curate ("Studio Ghibli," "Watch with Mom"), some
          generate themselves by genre, director, or decade.
        </p>
      </div>
      <div class="col-span-4">
        <Image
          src={browseMain}
          alt="Cozystream browse page with collection rows and poster grid"
          class="shadow-sm"
          loading="lazy"
        />
        <Caption text="Collection rows with the full grid below" />
      </div>

      <!-- Detail Page -->
      <div class="col-span-2">
        <SmallHeading text="Detail page" />
        <p>
          Three layouts, same hierarchy. Backdrop mode adds blur and tint
          controls so text stays readable over any image.
        </p>
      </div>
      <div class="col-span-4 grid grid-cols-2 gap-4">
        <div>
          <Image
            src={detailBackdrop}
            alt="Cozystream detail page with full-bleed backdrop image layout"
            class="shadow-sm"
            loading="lazy"
          />
          <Caption text="Backdrop layout" />
        </div>
        <div>
          <Image
            src={detailHeader}
            alt="Cozystream detail page with contained poster header layout"
            class="shadow-sm"
            loading="lazy"
          />
          <Caption text="Header layout" />
        </div>
      </div>

      <!-- Editing metadata -->
      <div class="col-span-2">
        <SmallHeading text="Quick metadata editing" />
        <p>
          Cozystream doesn't always pull the right metadata. Search for the
          correct movie, select it, done.
        </p>
      </div>
      <div class="col-span-4">
        <video
          playsinline
          autoplay
          muted
          loop
          preload="metadata"
          poster={editingIssuePoster.src}
          class="shadow-sm"
        >
          <source src={editingIssue} type="video/webm" />
          <source src={editingIssueMp4} type="video/mp4" />
        </video>
        <Caption text="Searching and swapping to the correct movie" />
      </div>

      <!-- Editing poster -->
      <div class="col-span-2">
        <SmallHeading text="Poster selection" />
        <p>
          The default poster isn't always the best one. Pick from a set pulled
          off the web, with no uploading or file hunting.
        </p>
      </div>
      <div class="col-span-4">
        <video
          playsinline
          autoplay
          muted
          loop
          preload="metadata"
          poster={editingPosterPoster.src}
          class="shadow-sm"
        >
          <source src={editingPoster} type="video/webm" />
          <source src={editingPosterMp4} type="video/mp4" />
        </video>
        <Caption text="Choosing from available poster options" />
      </div>

      <!-- Player -->
      <div class="col-span-2">
        <SmallHeading text="Player" />
        <p>
          Controls hide during playback and come back on mouse movement. When
          the browser can't play a file natively, the server transcodes it to
          HLS with FFmpeg. The user just presses play.
        </p>
      </div>
      <div class="col-span-4">
        <video
          playsinline
          autoplay
          muted
          loop
          preload="metadata"
          poster={playerDemoPoster.src}
          class="shadow-sm"
        >
          <source src={playerDemo} type="video/webm" />
          <source src={playerDemoMp4} type="video/mp4" />
        </video>
        <Caption text="Controls appear on hover, then fade out" />
      </div>

      <!-- Smart TV -->
      <div class="col-span-2">
        <SmallHeading text="Smart TV" />
        <p>
          In progress. A visible focus ring moves between elements with the
          arrow keys, running as a web app inside LG's webOS and Samsung's
          Tizen browsers. Screenshots coming soon.
        </p>
      </div>

      <!-- Section: How I built it this fast -->
      <div class="col-span-2">
        <SmallHeading text="How I built it this fast" />
        <p>
          I designed and built Cozystream, using Claude Code as part of my
          workflow across Angular, Node.js, FFmpeg, and SQLite. The layout
          system, customization approach, TV navigation, and information
          hierarchy are my decisions. Working this way, I can design a feature
          and be using it the same day.
        </p>
      </div>

      <!-- Section: Still building -->
      <div class="col-span-2 sm:col-start-5">
        <SmallHeading text="Still building" />
        <ul class="space-y-2">
          <li>Getting it in front of my partner and her parents, then redesigning around what they tell me</li>
          <li>A guided onboarding flow for non-technical first-time setup</li>
          <li>A real responsive pass for phone and tablet</li>
          <li>More customization options</li>
          <li>An accessibility audit beyond the contrast checker</li>
        </ul>
      </div>
    </ProjectGrid6Cols>
  </main>
</Layout>
