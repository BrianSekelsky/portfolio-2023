---
interface Props {
  isLarge: boolean;
  value: string;
  year: string;
  types: { text: string; special: boolean }[];
  description: string;
}

const { value, types, year, description } = Astro.props;
---

<div class="">
  <div>
    <h3 class="font-sans text-3xl transition-all pt-4">{value}</h3>
    <p class="font-sans pt-4 max-w-1/2">{description}</p>
    <div class="flex flex-wrap gap-2 pt-6">
      {
        types.map((type) => (
          <span class="border px-4 py-1 font-sans text-xs text-zinc-700">
            {type.text}
          </span>
        ))
      }
    </div>
  </div>
</div>
