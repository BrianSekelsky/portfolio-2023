---
interface Props {
  isLarge: boolean;
  value: string;
  year: string;
  types: { text: string; special: boolean }[];
  description: string;
}

const { value, types, year, description } = Astro.props;
---

<div class="grid grid-cols-12 gap-x-4 sm:gap-x-8">
  <h3
    class="col-span-12 font-serif font-extralight text-4xl transition-all pt-2"
  >
    {value}
  </h3>
  <p class="col-span-12 md:col-span-6 pt-2">{description}</p>
  <div class="col-span-12 flex flex-wrap gap-2 pt-4">
    {
      types.map((type) => (
        <span class="border px-4 py-1 font-mono text-xs uppercase text-zinc-700">
          {type.text}
        </span>
      ))
    }
  </div>
</div>
