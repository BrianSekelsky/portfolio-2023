---
import SmallHeading from "./SmallHeading.astro";
import { Image } from "astro:assets";

interface Props {
  title: string;
  objective: string;
  types: string[];
  collaborators: string[];
  year: string;
  outboundLink?: string;
  music?: boolean;
  // Hero media props
  heroImage?: ImageMetadata;
  heroVideo?: string;
  heroVideoMp4?: string;
  heroPoster?: string;
  heroAlt?: string;
}
const {
  title,
  objective,
  types,
  collaborators,
  year,
  outboundLink = "",
  music = false,
  heroImage,
  heroVideo,
  heroVideoMp4,
  heroPoster,
  heroAlt = "Project hero image",
} = Astro.props;

const hasHero = heroImage || heroVideo || heroVideoMp4;
const hasCollaborators = collaborators.length > 0;
---

<div class="site-padding-flush project-header load-in">
  <div class="header-card flex flex-col">
    <!-- Title section -->
    <div class="title-section p-6 sm:p-8">
      <!-- <a
        href="/"
        class="inline-block w-fit text-sm border rounded-full px-4 py-1 mb-4 hover:bg-verylightgray dark:hover:bg-dark-surface-hover transition-colors back-link"
        >← Back to projects</a
      > -->
      <h1
        class="font-serif text-4xl sm:text-5xl wrap-break-word sm:break-normal hyphens-auto sm:hyphens-manual leading-[1.1]"
      >
        {title}
      </h1>
    </div>

    <!-- Project details bar at bottom -->
    <div class="project-details-bar p-6 sm:p-8 mt-auto">
      <div class="grid grid-cols-12 gap-x-8 gap-y-8 pb-8">
        <div class="col-span-12 sm:col-span-6">
          <p class="font-bold pb-2">Overview</p>
          <p class="">{objective}</p>
          <slot />
        </div>
        {
          hasCollaborators && (
            <div class="col-span-6 sm:col-span-2">
              <p class="font-bold pb-2">Collaborators</p>
              <div>
                {collaborators.map((collaborator) => (
                  <p class="">{collaborator}</p>
                ))}
              </div>
            </div>
          )
        }
        <div
          class={`col-span-6 sm:col-span-2 ${types.length > 0 ? "block" : "hidden"}`}
        >
          <p class="font-bold pb-2">{music ? "Genres" : "Type"}</p>
          <div>
            {types.map((type) => <p class="">{type}</p>)}
          </div>
        </div>
        <div class="col-span-6 sm:col-span-2">
          <p class="font-bold pb-2">Year</p>
          <p class="">{year}</p>
        </div>
      </div>
    </div>
    <!-- Hero media section -->
    {
      hasHero && (
        <div class="hero-media">
          {heroVideo || heroVideoMp4 ? (
            <video
              playsinline
              autoplay
              muted
              loop
              preload="metadata"
              poster={heroPoster}
              class="w-full block"
            >
              <source src={heroVideo} type="video/webm" />
              {heroVideoMp4 && <source src={heroVideoMp4} type="video/mp4" />}
            </video>
          ) : heroImage ? (
            <Image src={heroImage} alt={heroAlt} class="w-full block" />
          ) : null}
        </div>
      )
    }
  </div>
</div>

<style>
  .back-link {
    border-color: var(--border-color);
  }

  .hero-media {
    width: 100%;
    overflow: hidden;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .title-section {
    /* border-top: 1px solid var(--border-color); */
  }

  .project-details-bar {
    /* border-top: 1px solid var(--border-color); */
    /* background: rgba(255, 255, 255, 0.5); */
  }

  :global(.dark) .project-details-bar {
    /* background: rgba(10, 10, 26, 0.5); */
  }
</style>
