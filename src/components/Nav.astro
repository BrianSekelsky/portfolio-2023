---
import NavLink from "./Nav-link.astro";
---

<nav class="static z-51 border-b bg-purewhite text-black lg:sticky lg:top-0">
  <div class="nav-load-in mx-auto">
    <div class="grid grid-cols-12 gap-x-4 sm:gap-x-8 gap-y-2 py-4 site-padding">
      <div class="col-span-12 lg:col-span-6">
        <a
          href="/#"
          class="w-full bold flex justify-start hover:underline transition-all dark:text-dark-text"
          >Brian Sekelsky</a
        >
      </div>
      <div
        class="col-span-12 lg:col-span-6 flex flex-wrap gap-8 lg:justify-start pt-2 lg:pt-0"
      >
        <NavLink href="/" name="Projects" />
        <NavLink href="/about/" name="About" />
        <NavLink href="/music/" name="Music" />
        <NavLink href="/teaching/" name="Teaching" />
      </div>
    </div>
  </div>
</nav>

<style>
  .nav-load-in {
    opacity: 0;
    animation: navLoadIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes navLoadIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-load-in {
      animation: none;
      opacity: 1;
    }
  }
</style>
