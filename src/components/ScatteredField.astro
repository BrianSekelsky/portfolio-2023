---
import { Image } from "astro:assets";
import { projects } from "./scatter-data.js";
---

<div id="scatter-field" class="scatter-field">
  {
    projects.map((project, i) => (
      <a
        class={`scatter-item ${project.isCaseStudy ? "scatter-large" : ""}`}
        href={project.href}
        data-index={i}
      >
        <Image
          src={project.image}
          alt={project.alt}
          loading="eager"
          widths={[160, 240, 320, 480]}
          sizes="(min-width: 768px) 240px, 160px"
        />
      </a>
    ))
  }
</div>

<script>
  import "../scripts/scatter-field.js";
</script>

<style>
  .scatter-field {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .scatter-item {
    position: absolute;
    opacity: 0;
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    will-change: transform;
    transition: opacity 0.4s ease, box-shadow 0.2s ease;
  }

  .scatter-item:hover {
    z-index: 10;
  }

  .scatter-item:hover :global(img) {
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
  }

  /* Case study projects: larger thumbnails */
  .scatter-large {
    width: 220px;
  }

  /* Other projects: smaller thumbnails */
  .scatter-item:not(.scatter-large) {
    width: 140px;
  }

  .scatter-item :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: box-shadow 0.2s ease;
  }

  @media (max-width: 767px) {
    .scatter-large {
      width: 160px;
    }

    .scatter-item:not(.scatter-large) {
      width: 110px;
    }
  }
</style>
