---
import Card from "../Card.astro";
import { CARD_WIDTHS, CARD_SIZES } from "./card-image.js";
import { Image } from "astro:assets";
import image from "../../images/homepage/size-scale-still.png";
import video from "../../images/homepage/size&scale.webm";
import videomp4 from "../../images/homepage/size&scale.mp4";
import poster from "../../images/homepage/size&scale-poster.jpg";

const title = "Scale Worlds";
const year = "2021–2023";
const types = [
  { text: "Virtual Reality", special: false },
  { text: "Web", special: false },
  { text: "Research", special: false },
  { text: "design engineering", special: false },
];
const alt = "Scale Worlds web interface showing size comparison across scales";
const description =
  "Designing immersive learning environments, first in VR and then adapted for the web, to help students understand size and scale.";
---

<Card
  href="projects/scale-worlds"
  title={title}
  types={types}
  year={year}
  description={description}
>
  <div class="hidden md:block">
    <video
      class="transition-all"
      playsinline
      muted
      loop
      preload="none"
      poster={poster.src}
      data-lazy-video
      aria-hidden="true"
    >
      <source src={video} type="video/webm" />
      <source src={videomp4} type="video/mp4" />
    </video>
  </div>
  <div class="flex md:hidden">
    <Image
      class="transition-all"
      src={image}
      alt={alt}
      loading="lazy"
      widths={CARD_WIDTHS}
      sizes={CARD_SIZES}
    />
  </div>
</Card>
