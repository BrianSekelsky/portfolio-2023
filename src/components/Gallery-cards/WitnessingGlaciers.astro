---
import CardLabel from "../Card-label.astro";
import Card from "../Card.astro";
import { CARD_WIDTHS, CARD_SIZES } from "./card-image.js";
import video from "../../images/homepage/glaciers.webm";
import videomp4 from "../../images/homepage/glaciers.mp4";
import poster from "../../images/homepage/glaciers-poster.jpg";
import { Image } from "astro:assets";
import gif from "../../images/homepage/glaciers.png";

const title = "Witnessing Glaciers";
const description = "this is an explanation about project 1";
const year = "2022";
const types = [
  { text: "Website", special: false },
  { text: "Branding", special: false },
  { text: "Design engineering", special: false },
];
const size = "medium";
const hasVideo = true;
const alt =
  "Clip of zooming out from astronaut perspective up to whale perspective";
---

<Card
  size="small"
  href="projects/witnessing-glaciers"
  title={title}
  types={types}
  year={year}
  myColor="ghostwhite"
  description="Web-based storytelling project sharing data about landmark glaciers and empathizing environmental urgency."
>
  <div class="hidden md:flex justify-center items-center bg-color h-full">
    <video
      class="transition-all"
      playsinline
      muted
      loop
      preload="none"
      poster={poster.src}
      data-lazy-video
      aria-hidden="true"
    >
      <source src={video} type="video/webm" />
      <source src={videomp4} type="video/mp4" />
    </video>
  </div>
  <div class="gif block md:hidden">
    <Image
      class="transition-all"
      src={gif}
      alt={alt}
      loading="lazy"
      widths={CARD_WIDTHS}
      sizes={CARD_SIZES}
    />
  </div>
</Card>

<style>
  .bg-color {
    position: relative;
    background-color: var(--myColor);
  }
</style>
