---
const currentPath = new URL(Astro.request.url).pathname;

interface Props {
  href: string;
  name: string;
}

const { href, name } = Astro.props;
---

<a href={href}>
  <span
    class={currentPath === href
      ? "text-black font-medium lg:first:ml-0 transition-all"
      : "lg:first:ml-0 hover:text-black hover:font-medium text-zinc-500 transition-all"}
  >
    {name}
  </span>
</a>
