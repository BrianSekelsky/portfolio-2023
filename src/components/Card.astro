---
import CardLabel from "./Card-label.astro";

interface Props {
  href: string;
  title: string;
  types: { text: string; special: boolean }[];
  year: string;
  description?: string;
}

const { href, title, types, year, description = "" } = Astro.props;
---

<a
  class=`group flex flex-col col-span-6 md:col-span-6 cursor-pointer bg-purewhite card h-full`
  href={href}
>
  <div class="w-full bg-white card-media">
    <slot />
  </div>
  <div class="py-4 flex-1">
    <CardLabel
      value={title}
      types={types}
      year={year}
      isLarge={false}
      description={description}
    />
  </div>
</a>

<style>
  .card-media {
    flex-shrink: 0;
  }

  .card-media :global(img),
  .card-media :global(video) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
